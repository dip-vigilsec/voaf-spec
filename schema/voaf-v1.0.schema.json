{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vigilsec.ai/voaf/v1.0/schema.json",
  "title": "VOAF — Vigil Open Audit Format v1.0",
  "description": "Schema for cryptographically verifiable AI interaction audit trail entries.",
  "type": "array",
  "items": {
    "$ref": "#/$defs/VoafEntry"
  },
  "$defs": {
    "VoafEntry": {
      "type": "object",
      "required": [
        "voaf",
        "id",
        "timestamp",
        "provider",
        "model",
        "direction",
        "content_hash",
        "prev_hash"
      ],
      "properties": {
        "voaf": {
          "type": "string",
          "const": "1.0.0",
          "description": "VOAF schema version."
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique event identifier."
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of when the event was recorded."
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "description": "AI provider identifier (e.g. 'openai', 'anthropic', 'google', 'cohere')."
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "description": "Model identifier (e.g. 'gpt-4o', 'claude-sonnet-4-20250514')."
        },
        "direction": {
          "type": "string",
          "enum": ["request", "response"],
          "description": "Whether this entry records a request to or response from the AI provider."
        },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$",
          "description": "SHA-256 hash of the raw content body, prefixed with 'sha256:'."
        },
        "prev_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$",
          "description": "SHA-256 hash of the previous entry's canonical JSON. Genesis entry uses all zeros."
        },
        "gate_decision": {
          "type": "string",
          "enum": ["ALLOW", "BLOCK", "FLAG"],
          "description": "Pre-request gate decision."
        },
        "gate_reason": {
          "type": "string",
          "description": "Human-readable reason for BLOCK or FLAG decisions."
        },
        "gate_policy_id": {
          "type": "string",
          "description": "Identifier of the policy that triggered the gate decision."
        },
        "gate_layer": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255,
          "description": "Detection layer that triggered the decision (1=signatures, 2=policy, 3=anomaly)."
        },
        "session_id": {
          "type": "string",
          "description": "Groups related interactions into a logical session."
        },
        "user_id": {
          "type": "string",
          "description": "Pseudonymous user identifier."
        },
        "device_id": {
          "type": "string",
          "description": "Originating device identifier."
        },
        "content_body": {
          "type": "string",
          "description": "Raw content body. May be omitted for privacy; content_hash is sufficient for verification."
        },
        "token_count": {
          "type": "object",
          "properties": {
            "input": {
              "type": "integer",
              "minimum": 0
            },
            "output": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "description": "Token usage for this interaction."
        },
        "latency_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "Round-trip latency in milliseconds."
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Freeform tags for categorization."
        },
        "annotations": {
          "type": "object",
          "additionalProperties": true,
          "description": "Arbitrary key-value metadata."
        },
        "decomposition": {
          "type": "object",
          "properties": {
            "intent": {
              "type": "string",
              "description": "Detected intent of the interaction."
            },
            "entities": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "type": { "type": "string" },
                  "value": { "type": "string" },
                  "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
                },
                "required": ["type", "value"]
              },
              "description": "Extracted entities."
            },
            "risk_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Composite risk score."
            },
            "categories": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Semantic categories assigned to this interaction."
            }
          },
          "additionalProperties": true,
          "description": "Semantic decomposition output."
        }
      },
      "if": {
        "properties": {
          "gate_decision": {
            "enum": ["BLOCK", "FLAG"]
          }
        },
        "required": ["gate_decision"]
      },
      "then": {
        "required": ["gate_reason"]
      },
      "additionalProperties": false
    }
  }
}
